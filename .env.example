# Copy to .env:  cp .env.example .env
#
# Option 4 — Career Intelligence (resume vs job postings)


# --- Database ---
# Docker Compose uses POSTGRES_* for the db container.
# Backend uses DATABASE_URL (localhost when running API on host, @db in Docker).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=career_intelligence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_intelligence


# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000


# --- AI (OpenAI) ---
# Required for RAG chat, embeddings, match scoring, and dynamic suggestions.
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
